HOST=127.0.0.1
PORT=8790
CORS_ORIGIN=http://localhost:3000
AUTH_REQUIRED=false
NEXUS_AI_CORE_SERVICE_TOKEN=
RATE_LIMIT_PER_MINUTE=60

# Optional provider credentials. Keep these server-side only.
GITHUB_API_TOKEN=
CURSEFORGE_API_KEY=

# Optional credential-free metadata persistence.
MONITOR_STATE_FILE=

# Disabled by default. Configure the webhook URL as:
# /api/v1/webhooks/github?sourceId=<registered-source-id>
GITHUB_WEBHOOKS_ENABLED=false
GITHUB_WEBHOOK_SECRET=
