# Standalone service defaults.
HOST=127.0.0.1
PORT=8790
CORS_ORIGIN=http://localhost:3000
AUTH_REQUIRED=false
NEXUS_AI_CORE_SERVICE_TOKEN=
RATE_LIMIT_PER_MINUTE=60

# Desktop sidecar launch overrides. The desktop should generate the token and nonce.
# Sidecar mode requires HOST=127.0.0.1 or ::1, PORT=0 is recommended, and authentication is mandatory.
NEXUS_AI_CORE_STARTUP_NONCE=
NEXUS_AI_CORE_READY_FILE=
NEXUS_AI_CORE_PARENT_PID=
NEXUS_AI_CORE_PARENT_CHECK_INTERVAL_MS=1000
NEXUS_AI_CORE_SHUTDOWN_GRACE_MS=5000

# General Nexus AI provider. Deterministic local behavior remains the default.
AI_PROVIDER=deterministic-local
AI_PROVIDER_FALLBACK=disabled
AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
AI_PROVIDER_CIRCUIT_FAILURE_WINDOW_MS=60000
AI_PROVIDER_CIRCUIT_COOLDOWN_MS=30000

# Required only when AI_PROVIDER=openai-responses.
# Keep the key server-side; never place it in desktop renderer state or request bodies.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=1000
OPENAI_MAX_RESPONSE_BYTES=1000000
OPENAI_RETRIES=2
OPENAI_REASONING_EFFORT=
OPENAI_DAILY_REQUEST_BUDGET=0
OPENAI_DAILY_TOKEN_BUDGET=0

# Optional update-source provider credentials. Keep these server-side only.
GITHUB_API_TOKEN=
CURSEFORGE_API_KEY=

# Optional credential-free metadata persistence. Use an absolute private path in sidecar mode.
MONITOR_STATE_FILE=

# Standalone-only webhook configuration. Desktop sidecar mode always disables webhook intake.
# /api/v1/webhooks/github?sourceId=<registered-source-id>
GITHUB_WEBHOOKS_ENABLED=false
GITHUB_WEBHOOK_SECRET=
